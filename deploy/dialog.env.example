# Install as /etc/dialog.env, root:root, mode 0600. Never commit live keys.
PYTHONPATH=/opt/dialog/current
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
XDG_CACHE_HOME=/var/cache/dialog
NEGO_AI=off
NEGO_JUDGE=0
NEGO_HTTP_PASSWORD=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENAI_REALTIME_KEY=
NEGO_ALLOWED_ORIGINS=https://dialog.2-26-49-28.nip.io
NEGO_FRONTEND_DIST=/opt/dialog/current/frontend/dist
NEGO_MAX_WEBSOCKETS=128
# Доля этого потолка на один адрес, с партией или без (локальные не считаются).
NEGO_MAX_WEBSOCKETS_PER_HOST=24
NEGO_WS_INIT_TIMEOUT_S=10
NEGO_MAX_SESSIONS_PER_HOST=12
# Живое видео собеседника: включают сервис И ключ; пусто — рисованный портрет.
# docs/INTEGRATION_LIVE_VIDEO.md. Выключить — NEGO_LIVE_VIDEO=off.
NEGO_LIVE_VIDEO=
NEGO_LIVE_VIDEO_KEY=
NEGO_LIVE_VIDEO_AVATAR=
# Серверная аттестация экзамена: выключена, пока обе строки закомментированы
# (экран говорит «выдача свидетельств не включена»). Включать по решению
# владельца — кто хранит ключ и сколько живёт реестр: docs/ATTESTATION_12206.md.
# Ключ — 64 hex-символа (openssl rand -hex 32), реестр — только под
# StateDirectory службы: /opt/dialog/current сменяется релизом, /tmp приватный.
# NEGO_ATTESTATION_KEY=
# NEGO_ATTESTATION_DB=/var/lib/dialog/attestations.sqlite
