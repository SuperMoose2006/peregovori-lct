[Unit]
Description=Dialog negotiation trainer
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=dialog
Group=dialog
WorkingDirectory=/opt/dialog/current/services/gateway
EnvironmentFile=/etc/dialog.env
ExecStart=/opt/dialog/current/services/gateway/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8010 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1 --ws websockets --ws-max-size 8388608 --ws-max-queue 4 --ws-ping-interval 20 --ws-ping-timeout 20 --timeout-graceful-shutdown 20 --no-access-log
Restart=always
RestartSec=3
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
StateDirectory=dialog
CacheDirectory=dialog
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryHigh=1536M
MemoryMax=2G
CPUQuota=400%
TasksMax=128
LimitNOFILE=8192
Nice=5

[Install]
WantedBy=multi-user.target
