# Скопировать в services/gateway/.env и вписать ключ. .env в .gitignore.
#
# Один ключ на всё облако: OpenRouter — единый шлюз для реплик оппонента,
# судьи, зрения, распознавания речи и генерации сценариев.
OPENAI_API_KEY=sk-or-...
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# --- модель на роль (все необязательные, дефолты в providers/routing.py) ----
# Судья стоит в критическом пути хода, реплику оппонента человек слышит вслух —
# поэтому роли разведены и не обязаны быть одной моделью.
#NEGO_MODEL_OPPONENT=google/gemini-3.5-flash-lite
#NEGO_MODEL_JUDGE=google/gemini-2.5-flash-lite
#NEGO_MODEL_VISION=google/gemini-3.1-flash-lite
#NEGO_MODEL_REASONING=z-ai/glm-5.3
#NEGO_MODEL_ASR=google/gemini-3.7-flash

# Максимальное качество реплик для демо:
#NEGO_MODEL_OPPONENT=moonshotai/kimi-k3

# --- выключатели ------------------------------------------------------------
#NEGO_AI=off            # полный офлайн: игра целиком на шаблонах движка
#NEGO_JUDGE=0           # без семантического судьи (детерминированный keyword-путь)
#NEGO_TURN_DETECT=0     # без детектора конца реплики (тишина = конец хода)

# --- аватар с липсинком (отдельный сервис, нужен CUDA-GPU) ------------------
# Пусто → провайдер `presence`: состояния персонажа, работает везде.
#NEGO_AVATAR_URL=http://gpu-host:8020
