# Скопировать в services/gateway/.env и вписать ключ. .env в .gitignore.
#
# Один ключ на всё облако: OpenRouter — единый шлюз для реплик оппонента,
# судьи, зрения, распознавания речи и генерации сценариев.
OPENAI_API_KEY=sk-or-...
# OPENAI_BASE_URL УБРАНА: её не читает никто. Адрес провайдера зашит
# константой `_BASE_URL` в app/providers/openrouter/chat.py. Строка здесь
# обещала настройку, которой нет: переставивший её на свой шлюз получил бы
# запросы, по-прежнему уходящие в OpenRouter, и ни одной жалобы.

# --- модель на роль (все необязательные, дефолты в providers/routing.py) ----
# Судья стоит в критическом пути хода, реплику оппонента человек слышит вслух —
# поэтому роли разведены и не обязаны быть одной моделью.
#NEGO_MODEL_OPPONENT=google/gemini-3.5-flash-lite
#NEGO_MODEL_JUDGE=google/gemini-2.5-flash-lite
#NEGO_MODEL_VISION=google/gemini-3.1-flash-lite
#NEGO_MODEL_REASONING=z-ai/glm-5.3
#NEGO_MODEL_ASR=google/gemini-3.7-flash

# Максимальное качество реплик для демо:
#NEGO_MODEL_OPPONENT=moonshotai/kimi-k3

# --- выключатели ------------------------------------------------------------
#NEGO_AI=off            # полный офлайн: игра целиком на шаблонах движка
#NEGO_JUDGE=0           # без семантического судьи (детерминированный keyword-путь)
#NEGO_TURN_DETECT=0     # без детектора конца реплики (тишина = конец хода)

# --- аватар с липсинком (отдельный сервис, нужен CUDA-GPU) ------------------
# Пусто → провайдер `presence`: состояния персонажа, работает везде.
#NEGO_AVATAR_URL=http://gpu-host:8020

# --- фронтенд на ДРУГОМ сервере (раздельное развёртывание) -------------------
# Пусто → шлюз ведёт себя как раньше: раздаёт frontend/dist и не пускает чужие
# origin'ы. Список задан → CORS отвечает этим адресам поимённо и с учётными
# данными (иначе браузер не отдаст странице билет для сокета).
# Подробности и проверка — docs/hosting.md.
#NEGO_ALLOWED_ORIGINS=https://dialog.example,https://www.dialog.example
# Каталог собранного фронтенда, если он лежит не рядом с репозиторием.
# Нет каталога вовсе → шлюз поднимается в режиме «только API», `/` отвечает
# честным {"spa": false}.
#NEGO_FRONTEND_DIST=/srv/dialog/dist

# --- demo speech: local Parakeet; failure -> visible error + text input ---
NEGO_VOICE=classic
NEGO_ASR=parakeet
#NEGO_ASR_URL=http://127.0.0.1:8020
#NEGO_ASR_TIMEOUT_S=20
# Cloud recognition requires explicit NEGO_ASR=openrouter or NEGO_VOICE=realtime.
# NEGO_MODEL_ASR selects only the OpenRouter model, never the local recognizer.

# --- живое видео собеседника (внешний сервис) --------------------------------
# ВКЛЮЧАЮТ КРЕДЫ: названный сервис И его ключ. Нет ключа — рисованный портрет,
# ровно как без этой секции. Выключить обратно — NEGO_LIVE_VIDEO=off.
# Шаги, проверка за две минуты и что может не сойтись — docs/INTEGRATION_LIVE_VIDEO.md.
#NEGO_LIVE_VIDEO=liveavatar          # anam | liveavatar | simli | stub | off
#NEGO_LIVE_VIDEO_KEY=                # ключ этого сервиса (без кавычек и пробелов)
#NEGO_LIVE_VIDEO_AVATAR=             # id лица у сервиса; пусто — стоковое (у simli обязательно)
#NEGO_LIVE_VIDEO_SANDBOX=1           # liveavatar: бесплатная песочница ~1 мин для первой проверки
# Тонкая настройка — после первого замера (tools/live_video_check.py печатает цифры):
#NEGO_LIVE_VIDEO_AV_DELAY_MS=600     # на сколько придержать звук, чтобы кадр успевал
#NEGO_LIVE_VIDEO_STALL_MS=1500       # лицо отстало от голоса больше — вернуть портрет
#NEGO_LIVE_VIDEO_PTS_OFFSET_MS=0     # губы спешат (+) или отстают (−) — сдвиг кадров
#NEGO_LIVE_VIDEO_FPS=15              # кадров в секунду на провод
#NEGO_LIVE_VIDEO_SIZE=320            # сторона кадра, px
#NEGO_LIVE_VIDEO_INPUT=audio         # audio — голос наш; text — голос сервиса (только stub)
#NEGO_LIVE_VIDEO_MAX_FAILURES=3      # отказов за партию до портрета насовсем
#NEGO_LIVE_VIDEO_CONNECT_TIMEOUT_S=12
# Репетиция отказа без денег: заглушка рвёт связь через N секунд после подключения.
#NEGO_LIVE_VIDEO_STUB_FAIL_AFTER_S=40
#NEGO_LIVE_VIDEO_STUB_LATENCY_MS=250
